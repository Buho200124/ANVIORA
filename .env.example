# ============================================================
# ANVIORA - Variables de entorno (copia este archivo a ".env")
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / Mac:           cp .env.example .env
# NUNCA subas el archivo .env a un repositorio.
# ============================================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=anviora_user
# Usa solo letras y números: esta clave va dentro de una URL de conexión
POSTGRES_PASSWORD=cambia_esta_clave_123
POSTGRES_DB=anviora_db

# --- Seguridad ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
# Clave para que los microservicios se hablen entre sí (genérala igual que la anterior)
INTERNAL_API_KEY=cambia-esta-clave-interna-por-otra-larga

# --- Operación ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# En producción pon el dominio real, ej: https://anviora.midominio.com
CORS_ORIGINS=*

# --- Monitoreo (solo con --profile monitoring) ---
GRAFANA_ADMIN_PASSWORD=cambia_esta_clave_grafana
